# ==========================================
# Imaginex - Environment Configuration Template
# ==========================================

# Server Port (Set to 8080 to match the client/vite.config.js proxy target)
PORT=8080

# Environment Mode (development | production)
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
# Local: mongodb://localhost:27017/imaginex
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/imaginex?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/imaginex

# JSON Web Token Secret for Authentication
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini API Key (used by @google/genai for AI image generation)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Configuration (used to store and serve generated images)
# Get your credentials at: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=dqdejbfnx
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
